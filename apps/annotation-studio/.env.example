# Self-instrumentation only (this app's own FastAPI/SQLite traces). Mint a fresh
# write token for a new dedicated 'annotation-studio' Logfire project.
LOGFIRE_TOKEN=

# Read-only access to the Logfire project you want to annotate.
LOGFIRE_READ_TOKEN=

# Append-only annotation events sent back to that same Logfire project. This is
# distinct from both the read token above and Annotation Studio's own LOGFIRE_TOKEN.
LOGFIRE_WRITE_TOKEN=

# Publishes queue exports as Logfire hosted datasets (project:write_datasets scope),
# minted separately from the read/write tokens above.
LOGFIRE_DATASETS_TOKEN=

ANNOTATION_STUDIO_DATABASE_PATH=data/annotation_studio.sqlite3
