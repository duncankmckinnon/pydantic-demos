# Compose-level configuration, read by `docker compose` itself when interpolating
# docker-compose.yml (host port mappings, etc.) — distinct from each app's own
# apps/<name>/.env, which only sets variables inside that app's container. Copy this
# to .env in the repo root if you want to override a default; every entry below
# works fine unset.

# Host ports each demo is reachable at (each container's own internal port is fixed).
CHAT_PORT=8001
RX_ASSISTANT_PORT=8002
RX_ASSISTANT_DB_PORT=5433
ANNOTATION_STUDIO_PORT=8003
